# Generates a C++ source file defining a function that returns the content of a text file.
# Run in script mode by add_custom_command() (see embed_text_function() in CMakeLists.txt):
#   cmake -DINPUT=<text file> -DOUTPUT=<generated .cpp> -DFUNCTION=<name> -DHEADER=<header declaring it> -P embed_text.cmake

foreach (var INPUT OUTPUT FUNCTION HEADER)
    if (NOT DEFINED ${var})
        message(FATAL_ERROR "embed_text.cmake: ${var} is not defined")
    endif ()
endforeach ()

file(READ "${INPUT}" content)

# The content is embedded as a raw string literal: its delimiter must not appear in the text
set(delimiter "embedded-text")
string(FIND "${content}" ")${delimiter}\"" delimiter_pos)
if (NOT delimiter_pos EQUAL -1)
    message(FATAL_ERROR "embed_text.cmake: ${INPUT} contains the raw string delimiter ')${delimiter}\"'")
endif ()

# Built with string(APPEND) on quoted arguments: a CMake list would split the text on every ';'
set(source "// Generated by cmake/embed_text.cmake from ${INPUT}. Do not edit.\n")
string(APPEND source "#include <string>\n\n")
string(APPEND source "#include \"${HEADER}\"\n\n")
string(APPEND source "std::string ${FUNCTION}() {\n")
string(APPEND source "    return R\"${delimiter}(${content})${delimiter}\";\n")
string(APPEND source "}\n")

# Do not touch the output if nothing changed, to avoid useless rebuilds
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if (previous STREQUAL source)
        return()
    endif ()
endif ()
file(WRITE "${OUTPUT}" "${source}")
